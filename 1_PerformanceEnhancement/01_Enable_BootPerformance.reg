Windows Registry Editor Version 5.00

; ============================================================
; CS2 OPTIMIZATION PACK - ENABLE BOOT PERFORMANCE
; ============================================================
; Autor: ptrkfps - Engenheiro de Windows Internals / eSports
; Compatibilidade: Windows 11 25H2 / Intel i5-14400F
; Objetivo: Otimizar tempo de boot e reduzir latência de kernel
; ============================================================

; KERNEL SCHEDULER OPTIMIZATION
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management]
"ClearPageFileAtShutdown"=dword:00000000
"LargeSystemCache"=dword:00000001
"SessionViewSize"=dword:00000030

; BOOT PHASE REDUCTION
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control]
"WaitToKillServiceTimeout"="5000"
"HungAppTimeout"="2000"

; DISABLE STARTUP DELAY
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer]
"ShellState"=hex:24,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00

; FASTER BOOT ON RESUMPTION
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\W32Time]
"Start"=dword:00000002
"Type"=dword:00000020

; REDUCE BOOT ANIMATION OVERHEAD
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\BootControl]
"BootProgressDisable"=dword:00000001

; OPTIMIZE INTERRUPT TIMING
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Kernel]
"IncreaseUserVa"=dword:00000001
"CoalescingTimerInterval"=dword:00000000

; DISABLE PREFETCH OVERHEAD FOR GAMES
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters]
"EnablePrefetcher"=dword:00000001
"EnableSuperfetch"=dword:00000001

; NETWORK STACK INITIALIZATION PRIORITY
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters]
"TcpTimedWaitDelay"=dword:0000001E
"TcpMaxConnections"=dword:0000FFFF
"TcpMaxDataRetransmissions"=dword:00000003

; ============================================================
; IMPACTO ESPERADO:
; - Redução de 2-4 segundos no boot
; - Menor latência de mouse/teclado no carregamento inicial
; - Melhor estabilidade após wake-up
; ============================================================
