Windows Registry Editor Version 5.00

; ============================================================
; CS2 OPTIMIZATION PACK - DISABLE DEEP TELEMETRY
; ============================================================
; Autor: ptrkfps - Engenheiro de Windows Internals / eSports
; Compatibilidade: Windows 11 25H2
; Objetivo: Desativar AllowTelemetry, DiagTrack e coleta agressiva
; NOTA: Windows Defender e Update permanecem 100% ativos
; ============================================================

; DISABLE TELEMETRY DATA COLLECTION
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\DataCollection]
"AllowTelemetry"=dword:00000000
"DisableTelemetry"=dword:00000001
"MininumTelemetryLevel"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\DataCollection]
"AllowTelemetry"=dword:00000000

; DISABLE DIAGNOSTIC TRACKING
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\DiagTrack]
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\dmwappushservice]
"Start"=dword:00000004

; DISABLE ACTIVITY HISTORY
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\System]
"PublishUserActivities"=dword:00000000
"UploadUserActivities"=dword:00000000
"EnableActivityFeed"=dword:00000000

; DISABLE TAILORED EXPERIENCES
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Privacy]
"TailoredExperiencesWithDiagnosticDataEnabled"=dword:00000000
"GeneralDataSharingEnabled"=dword:00000000

; DISABLE ADVERTISING ID
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo]
"Enabled"=dword:00000000
"OptedInNetworkRequestsOnly"=dword:00000000

; DISABLE APP LAUNCH TRACKING
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"Start_TrackProgs"=dword:00000000

; DISABLE TYPED SEARCH HISTORY
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\SearchSettings]
"IsAADAccount"=dword:00000000
"IsMSAAccount"=dword:00000000

; DISABLE COMPATIBILITY TELEMETRY
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\Layers]
"EnableCompatTelemetry"=dword:00000000

; DISABLE CORTANA DATA COLLECTION
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Search]
"BingSearchEnabled"=dword:00000000
"CortanaConsent"=dword:00000000

; DISABLE CONNECTED EXPERIENCES
[HKEY_CURRENT_USER\Software\Microsoft\Office\16.0\Common\Internet]
"UseOnlineContent"=dword:00000000

; DISABLE CRASH DUMP COLLECTION FOR THIRD-PARTY APPS
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\Windows Error Reporting\LocalDumps]
"Enabled"=dword:00000000

; DISABLE APP USAGE TRACKING
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\AppPrivacy]
"LetAppsRunInBackground"=dword:00000002

; ============================================================
; PROTEÇÕES MANTIDAS (NÃO ALTERADAS):
; ============================================================
; - Windows Defender (WinDefend)
; - Windows Update (wuauserv)
; - Windows Security (SecurityHealthService)
; - Network Security (WlanSvc)
; - Firewall (MpsSvc)
; ============================================================

; IMPACTO ESPERADO:
; - Redução de 2-4% overhead de CPU background tasks
; - Eliminação de microstutters causados por telemetry
; - Menor latência de disco (menos writes em %appdata%)
; - Responsividade imediata ao iniciar CS2
; ============================================================
