Windows Registry Editor Version 5.00

; ============================================================
; CS2 OPTIMIZATION PACK - DISABLE ADVERTISING ID
; ============================================================
; Autor: ptrkfps - Engenheiro de Windows Internals / eSports
; Compatibilidade: Windows 11 25H2
; Objetivo: Desativar ID de publicidade e rastreamento de perfil
; ============================================================

; DISABLE ADVERTISING ID
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo]
"Enabled"=dword:00000000
"OptedInNetworkRequestsOnly"=dword:00000000

; DISABLE APP SUGGESTIONS BASED ON ADVERTISING PROFILE
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Privacy]
"LetAppsAccessAccountInfo"=dword:00000002
"LetAppsAccessCalendar"=dword:00000002
"LetAppsAccessContacts"=dword:00000002
"LetAppsAccessEmail"=dword:00000002
"LetAppsAccessLocation"=dword:00000002
"LetAppsAccessMicrophone"=dword:00000002
"LetAppsAccessMotion"=dword:00000002
"LetAppsAccessRadios"=dword:00000002
"LetAppsAccessTrustedDevices"=dword:00000002

; DISABLE INTEREST-BASED ADS
[HKEY_CURRENT_USER\Software\Microsoft\Personalization]
"PersonalizationBlobVersion"=dword:00000000

; DISABLE TARGETED ADS IN APPS
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\AppPrivacy]
"LetAppsAccessAccountInfo"=dword:00000002

; RESET ADVERTISING ID
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\AdvertisingInfo]
"Id"=""

; ============================================================
; IMPACTO ESPERADO:
; - Nenhum rastreamento de perfil de uso
; - Redução de requests HTTP em background
; - Menor overhead de processamento de anúncios
; ============================================================
